# --- LLM ---
# ollama | deepseek | auto (DeepSeek, при ошибке — Ollama)
LLM_BACKEND=auto

# DeepSeek (если используешь облако)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=20

# Локальная Ollama (если DeepSeek не нужен)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=2h

# --- TTS ---
VOICE_PITCH_SEMITONES=2.0
# PIPER_MODEL=./piper/ru_RU-denis-medium.onnx
# TTS_CACHE_DIR=./tts_cache

# --- Модели STT ---
# MODEL_DIR=./models

# --- Погода (met.no + ipwho.is, без ключей) ---
# Если пусто — определяется по IP.
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=

# --- Сервер ---
VOICE_SERVER_PORT=8000

# --- Память диалога (19.11) ---
# Сколько символов истории держать в контексте LLM (на одно соединение).
HISTORY_MAX_CHARS=4000
# Кому отдавать победу при близких log-prob: ru | en
STT_PREFER_LANGUAGE=ru
# Порог уверенности моделей (0.10 — легко побеждает ru, 0.25 — en нужен отрыв)
STT_RU_MARGIN=0.10
STT_EN_MARGIN=0.25

# --- Ollama ---
# Контекст модели. История диалога требует больше 512, иначе обрежется.
OLLAMA_NUM_CTX=4096
# Таймаут ответа: первый ответ после загрузки модели бывает медленным.
OLLAMA_TIMEOUT=45
