# --- LLM ---
# ollama | deepseek | auto (DeepSeek, при ошибке — Ollama)
LLM_BACKEND=auto

# DeepSeek (если используешь облако)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=20

# Локальная Ollama (если DeepSeek не нужен)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=2h

# --- TTS ---
VOICE_PITCH_SEMITONES=2.0
# PIPER_MODEL=./piper/ru_RU-denis-medium.onnx
# TTS_CACHE_DIR=./tts_cache

# --- Модели STT ---
# MODEL_DIR=./models

# --- Погода (met.no + ipwho.is, без ключей) ---
# Если пусто — определяется по IP.
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=

# --- Сервер ---
VOICE_SERVER_PORT=8000
